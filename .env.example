# ШАБЛОН. Скопируйте в .env и при необходимости измените:
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# Все значения ниже — ВЫМЫШЛЕННЫЕ локальные реквизиты для практики.
# Реальные секреты в репозиторий не попадают: .env в .gitignore.
# Эти же значения нужны и Compose (сервис db), и Python (DATABASE_URL).

# --- реквизиты PostgreSQL (читает Compose, сервис db) ---
POSTGRES_USER=practice
POSTGRES_PASSWORD=practice-only
POSTGRES_DB=sneaker_shop

# --- строка подключения для SQLAlchemy 2.0 + psycopg 3 ---
# Формат: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
# HOST/PORT — адрес с этого компьютера (127.0.0.1 и опубликованный порт 55433),
# а НЕ db:5432: имя db и порт 5432 работают только внутри сети Compose.
# При смене порта в compose.yaml (ports) эту строку нужно изменить согласованно.
DATABASE_URL=postgresql+psycopg://practice:practice-only@127.0.0.1:55433/sneaker_shop

# --- секрет подписи JWT (M3) ---
# Здесь НЕТ значения: ключ не должен попадать в репозиторий даже примером.
# Сгенерировать локальный ключ один раз:
#   python setup_jwt.py
# Скрипт положит случайный ключ (64 символа) в .env и НЕ перезапишет уже
# существующий. Без ключа приложение не стартует — это намеренно:
# запасного ключа в коде нет.
JWT_SECRET=
